# ---------------------------------------------------------------------------
# CodeWriter backend configuration
# Copy to `.env` and edit. Every value below is optional; the defaults work
# for a local-only setup on macOS.
# ---------------------------------------------------------------------------

# Port the HTTP server binds to.
PORT=8721

# Interface to bind. Use 127.0.0.1 to stay local-only.
# Use 0.0.0.0 only when you are fronting this with a tunnel or reverse proxy.
HOST=127.0.0.1

# The externally reachable base URL of this server. THIS MATTERS.
# It is used as the OAuth issuer, the resource identifier, and the base for
# every redirect. It MUST match the URL the MCP client actually dials.
#
# Local only:              http://127.0.0.1:8721
# Behind cloudflared:      https://something.trycloudflare.com
# Behind ngrok:            https://abcd-1-2-3-4.ngrok-free.app
PUBLIC_URL=http://127.0.0.1:8721

# Where the JSON "database" lives.
DATA_DIR=./data

# Access token lifetime in seconds (default 1 hour).
ACCESS_TOKEN_TTL=3600

# Refresh token lifetime in seconds (default 30 days).
REFRESH_TOKEN_TTL=2592000

# Authorization code lifetime in seconds (default 5 minutes).
AUTH_CODE_TTL=300

# Set to "true" to require an existing user to explicitly approve every new
# OAuth client on the consent screen. Set to "false" to auto-approve clients
# the user has already approved once.
ALWAYS_PROMPT_CONSENT=false

# Comma-separated Host header allowlist for DNS-rebinding protection on /mcp.
# Leave blank to derive it from PUBLIC_URL plus localhost.
MCP_ALLOWED_HOSTS=

# Max bytes of file content the MCP server will return in a single tool call.
MAX_READ_BYTES=1048576

# Max bytes of a single file the frontend will index / allow to be written.
MAX_FILE_BYTES=5242880

# Log level: debug | info | warn | error
LOG_LEVEL=info
